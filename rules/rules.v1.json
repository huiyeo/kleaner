{
  "schemaVersion": 1,
  "channel": "2026.08",
  "defaults": {
    "ageDays": 14,
    "ageDaysByCategory": {
      "temp": 14,
      "browser-cache": 7,
      "dev-cache": 14,
      "system": 14
    }
  },
  "rules": [
    {
      "id": "user-temp",
      "name": "用户临时目录",
      "category": "temp",
      "risk": "low",
      "paths": ["%LOCALAPPDATA%\\Temp\\**"],
      "requiresElevation": false,
      "safetyNotes": "Windows 与各应用写入的用户级临时目录，删除后按需自动重建。仅清理 14 天未修改的文件，跳过被占用文件（如安装未完成的临时文件）。",
      "safetyDoc": "docs/safety-notes.md#user-temp"
    },
    {
      "id": "chrome-http-cache",
      "name": "Chrome HTTP 缓存与代码缓存",
      "category": "browser-cache",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache\\**",
        "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache\\**"
      ],
      "requiresElevation": false,
      "safetyNotes": "Chrome 官方 HTTP 缓存与编译代码缓存目录，删除后自动重建，仅影响网页首次加载速度。不含 Cookie、登录态、历史记录与扩展数据，Chrome 运行中被锁定的文件自动跳过。",
      "safetyDoc": "docs/safety-notes.md#chrome-http-cache"
    },
    {
      "id": "edge-http-cache",
      "name": "Edge HTTP 缓存与代码缓存",
      "category": "browser-cache",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache\\**",
        "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache\\**"
      ],
      "requiresElevation": false,
      "safetyNotes": "Edge 官方 HTTP 缓存与编译代码缓存目录，删除后自动重建，仅影响网页首次加载速度。不含 Cookie、登录态、收藏与历史记录，Edge 运行中被锁定的文件自动跳过。",
      "safetyDoc": "docs/safety-notes.md#edge-http-cache"
    },
    {
      "id": "npm-cache",
      "name": "npm 包下载缓存",
      "category": "dev-cache",
      "risk": "low",
      "paths": ["%LOCALAPPDATA%\\npm-cache\\**"],
      "requiresElevation": false,
      "safetyNotes": "npm 下载的包缓存（npm 官方命令 npm cache clean --force 即清除此目录），删除后下次 install 重新从 registry 下载，不影响已安装项目与全局包。",
      "safetyDoc": "docs/safety-notes.md#npm-cache"
    },
    {
      "id": "pip-cache",
      "name": "pip 下载缓存",
      "category": "dev-cache",
      "risk": "low",
      "paths": ["%LOCALAPPDATA%\\pip\\cache\\**"],
      "requiresElevation": false,
      "safetyNotes": "pip 下载的 wheel/sdist 缓存（pip 官方命令 pip cache purge 即清除此目录），删除后下次安装重新下载，不影响已安装的 Python 环境。",
      "safetyDoc": "docs/safety-notes.md#pip-cache"
    },
    {
      "id": "kimi-desktop-updater",
      "name": "Kimi 桌面版更新器安装包",
      "category": "updater",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\kimi-desktop-updater\\**\\*.exe",
        "%LOCALAPPDATA%\\kimi-desktop-updater\\**\\*.nupkg"
      ],
      "keepNewest": 1,
      "requiresElevation": false,
      "safetyNotes": "Electron 应用 Kimi 桌面版自动更新器下载的历史安装包（.exe/.nupkg），不含配置、会话与用户数据。按版本规则保留最新 1 份用于回滚，其余清除。仅匹配安装包扩展名，更新器配置文件不受影响。",
      "safetyDoc": "docs/safety-notes.md#kimi-desktop-updater"
    },
    {
      "id": "workbuddy-desktop-updater",
      "name": "WorkBuddy 桌面版更新器安装包",
      "category": "updater",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\@genieworkbuddy-desktop-updater\\**\\*.exe",
        "%LOCALAPPDATA%\\@genieworkbuddy-desktop-updater\\**\\*.nupkg"
      ],
      "keepNewest": 1,
      "requiresElevation": false,
      "safetyNotes": "WorkBuddy 桌面版自动更新器下载的历史安装包（.exe/.nupkg），不含应用本体、配置与用户数据。保留最新 1 份用于回滚，其余清除。",
      "safetyDoc": "docs/safety-notes.md#workbuddy-desktop-updater"
    },
    {
      "id": "qoder-updater",
      "name": "Qoder 更新器安装包",
      "category": "updater",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\qoder-work-cn-updater\\**\\*.exe",
        "%LOCALAPPDATA%\\qoder-work-cn-updater\\**\\*.nupkg"
      ],
      "keepNewest": 1,
      "requiresElevation": false,
      "safetyNotes": "Qoder 桌面版自动更新器下载的历史安装包（.exe/.nupkg），不含应用本体、配置与用户数据。保留最新 1 份用于回滚，其余清除。",
      "safetyDoc": "docs/safety-notes.md#qoder-updater"
    },
    {
      "id": "zcode-desktop-updater",
      "name": "ZCode 桌面版更新器安装包",
      "category": "updater",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\@zcodedesktop-updater\\**\\*.exe",
        "%LOCALAPPDATA%\\@zcodedesktop-updater\\**\\*.nupkg"
      ],
      "keepNewest": 1,
      "requiresElevation": false,
      "safetyNotes": "ZCode 桌面版自动更新器下载的历史安装包（.exe/.nupkg），不含应用本体、配置与用户数据。保留最新 1 份用于回滚，其余清除。",
      "safetyDoc": "docs/safety-notes.md#zcode-desktop-updater"
    },
    {
      "id": "quark-updater",
      "name": "夸克网盘更新器安装包",
      "category": "updater",
      "risk": "low",
      "paths": [
        "%LOCALAPPDATA%\\QuarkCloudDriveUpdater\\**\\*.exe",
        "%LOCALAPPDATA%\\QuarkCloudDriveUpdater\\**\\*.nupkg"
      ],
      "keepNewest": 1,
      "requiresElevation": false,
      "safetyNotes": "夸克网盘自动更新器下载的历史安装包（.exe/.nupkg）。注意：同级的 QuarkCloudDriveMini 目录是应用数据，刻意不纳入任何规则。保留最新 1 份安装包，其余清除。",
      "safetyDoc": "docs/safety-notes.md#quark-updater"
    },
    {
      "id": "windows-temp",
      "name": "系统临时目录",
      "category": "system",
      "risk": "low",
      "paths": ["%SystemRoot%\\Temp\\**"],
      "requiresElevation": true,
      "safetyNotes": "Windows 系统级临时目录，官方磁盘清理/存储感知同样清理此位置。仅清理 14 天未修改的文件；需要管理员权限，未提权时不扫描。",
      "safetyDoc": "docs/safety-notes.md#windows-temp"
    },
    {
      "id": "windows-update-download",
      "name": "Windows 更新下载残留",
      "category": "system",
      "risk": "low",
      "paths": ["%SystemRoot%\\SoftwareDistribution\\Download\\**"],
      "requiresElevation": true,
      "safetyNotes": "Windows Update 已下载的安装文件缓存，官方磁盘清理的「Windows 更新清理」同类对象。清理后需要时自动重新下载；仅清理 14 天未修改的文件，需要管理员权限。",
      "safetyDoc": "docs/safety-notes.md#windows-update-download"
    }
  ]
}
