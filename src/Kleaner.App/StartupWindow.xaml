<Window x:Class="Kleaner.App.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StartupTitle" Height="560" Width="980"
        WindowStartupLocation="CenterOwner" Style="{StaticResource KleanerDialogWindow}">
    <DockPanel Margin="28,24,28,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Button x:Name="RefreshButton" Click="OnRefresh" Style="{StaticResource KleanerSecondaryButton}" />
            <Button x:Name="DisableButton" Click="OnDisable" Style="{StaticResource KleanerSecondaryButton}" Margin="8,0,0,0" />
            <Button x:Name="RestoreButton" Click="OnRestore" Style="{StaticResource KleanerPrimaryButton}" Margin="8,0,0,0" />
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom" Style="{StaticResource KleanerStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="…" />
            </StatusBarItem>
        </StatusBar>
        <Border Style="{StaticResource KleanerCard}"><DataGrid x:Name="StartupGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" SelectionChanged="OnSelectionChanged" Style="{StaticResource KleanerDataGrid}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="180" />
                <DataGridTextColumn Binding="{Binding Command}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Binding="{Binding Location}" IsReadOnly="True" Width="240" />
                <DataGridTextColumn Binding="{Binding TypeDisplay}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Binding="{Binding ElevatedDisplay}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Binding="{Binding StatusDisplay}" IsReadOnly="True" Width="70" />
            </DataGrid.Columns>
        </DataGrid></Border>
    </DockPanel>
</Window>
