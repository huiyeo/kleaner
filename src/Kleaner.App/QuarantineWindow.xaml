<Window x:Class="Kleaner.App.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuarantineTitle" Height="420" Width="760"
        WindowStartupLocation="CenterOwner" Style="{StaticResource KleanerDialogWindow}">
    <DockPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,16,0,0" HorizontalAlignment="Right">
            <Button x:Name="RestoreButton" Click="OnRestore" Style="{StaticResource KleanerPrimaryButton}" />
            <Button x:Name="DeleteButton" Click="OnDelete" Style="{StaticResource KleanerDangerButton}" Margin="8,0,0,0" />
            <Button x:Name="PurgeButton" Click="OnPurge" Style="{StaticResource KleanerDangerButton}" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
        <Border x:Name="PendingAuditBanner" DockPanel.Dock="Top" Background="#FFF9EC" BorderBrush="#EFD9A8" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="RecoverAuditButton" Click="OnRecoverPendingAudit" DockPanel.Dock="Right" Style="{StaticResource KleanerSecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock x:Name="PendingAuditText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource KleanerCard}"><DataGrid x:Name="BatchesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" Style="{StaticResource KleanerDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding BatchId}" Width="150" />
                <DataGridTextColumn Binding="{Binding CreatedDisplay}" Width="170" />
                <DataGridTextColumn Binding="{Binding EntryCount}" Width="90" />
                <DataGridTextColumn Binding="{Binding SizeDisplay}" Width="120" />
                <DataGridTextColumn Width="*" />
            </DataGrid.Columns>
        </DataGrid></Border>
    </DockPanel>
</Window>
