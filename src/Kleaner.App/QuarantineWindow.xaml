<Window x:Class="Kleaner.App.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隔离区" Height="420" Width="760"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="RestoreButton" Click="OnRestore" Width="110" Padding="0,4" />
            <Button x:Name="DeleteButton" Click="OnDelete" Width="110" Margin="8,0,0,0" Padding="0,4" />
            <Button x:Name="PurgeButton" Click="OnPurge" Width="130" Margin="8,0,0,0" Padding="0,4" />
        </StackPanel>
        <DataGrid x:Name="BatchesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding BatchId}" Width="150" />
                <DataGridTextColumn Binding="{Binding CreatedDisplay}" Width="170" />
                <DataGridTextColumn Binding="{Binding EntryCount}" Width="90" />
                <DataGridTextColumn Binding="{Binding SizeDisplay}" Width="120" />
                <DataGridTextColumn Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
