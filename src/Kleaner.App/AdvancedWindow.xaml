<Window x:Class="Kleaner.App.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="高级模式" Height="560" Width="860"
        WindowStartupLocation="CenterOwner" Style="{StaticResource KleanerDialogWindow}">
    <Window.Resources>
        <DataTemplate x:Key="BigItemTemplate">
            <Border BorderBrush="#ECECF1" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,10" Background="White" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,6" />
                    <Button Content="{Binding RunLabel}" Click="OnRunTool" Tag="{Binding}"
                            HorizontalAlignment="Left" Style="{StaticResource KleanerSecondaryButton}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
    <TabControl Grid.Row="1" Style="{StaticResource KleanerTabControl}">
        <TabItem x:Name="WslTab" Header="WSL">
            <DockPanel Margin="8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="WslDetectButton" Click="OnDetectWsl" Style="{StaticResource KleanerPrimaryButton}" />
                    <Button x:Name="WslCopyButton" Click="OnCopyGuide" Style="{StaticResource KleanerSecondaryButton}" Margin="8,0,0,0" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KleanerCard}"><ListView x:Name="WslList" SelectionChanged="OnWslSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="WslColPath" DisplayMemberBinding="{Binding Path}" Width="520" />
                                <GridViewColumn x:Name="WslColSize" DisplayMemberBinding="{Binding SizeDisplay}" Width="140" />
                            </GridView>
                        </ListView.View>
                    </ListView></Border>
                    <GroupBox x:Name="WslGuideBox" Grid.Row="2" Padding="6">
                        <TextBox x:Name="WslGuide" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                    </GroupBox>
                </Grid>
            </DockPanel>
        </TabItem>
        <TabItem x:Name="BigItemsTab" Header="BigItems">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                <ItemsControl x:Name="BigItemsList" />
            </ScrollViewer>
        </TabItem>
        <TabItem x:Name="RegistryTab" Header="Registry">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="RegistryScanButton" Click="OnRegistryScan" Style="{StaticResource KleanerPrimaryButton}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="RegistryNoteText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" />
                </StackPanel>
                <Border Style="{StaticResource KleanerCard}"><ListView x:Name="RegistryList">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="RegColName" DisplayMemberBinding="{Binding DisplayName}" Width="200" />
                            <GridViewColumn x:Name="RegColReason" DisplayMemberBinding="{Binding Reason}" Width="240" />
                            <GridViewColumn x:Name="RegColKey" DisplayMemberBinding="{Binding Key}" Width="380" />
                        </GridView>
                    </ListView.View>
                </ListView></Border>
            </DockPanel>
        </TabItem>
    </TabControl></Grid>
</Window>
