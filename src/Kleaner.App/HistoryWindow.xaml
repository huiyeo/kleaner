<Window x:Class="Kleaner.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作历史" Height="520" Width="900"
        WindowStartupLocation="CenterOwner" Style="{StaticResource KleanerDialogWindow}">
    <DockPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="OpenFileButton" Click="OnOpenFile" Style="{StaticResource KleanerSecondaryButton}" />
            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
        <Border Style="{StaticResource KleanerCard}"><DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource KleanerDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding TimeDisplay}" Width="175" />
                <DataGridTextColumn Binding="{Binding Action}" Width="110" />
                <DataGridTextColumn Binding="{Binding Detail}" Width="*" />
                <DataGridTextColumn Binding="{Binding FileCount}" Width="70" />
                <DataGridTextColumn Binding="{Binding BytesDisplay}" Width="100" />
                <DataGridTextColumn Binding="{Binding Result}" Width="80" />
            </DataGrid.Columns>
        </DataGrid></Border>
    </DockPanel>
</Window>
