<Window x:Class="Kleaner.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作历史" Height="520" Width="900"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="OpenFileButton" Click="OnOpenFile" Width="130" Padding="0,4" />
            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666" />
        </StackPanel>
        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding TimeDisplay}" Width="150" />
                <DataGridTextColumn Binding="{Binding Action}" Width="110" />
                <DataGridTextColumn Binding="{Binding Detail}" Width="*" />
                <DataGridTextColumn Binding="{Binding FileCount}" Width="70" />
                <DataGridTextColumn Binding="{Binding BytesDisplay}" Width="100" />
                <DataGridTextColumn Binding="{Binding Result}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
