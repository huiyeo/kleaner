<Window x:Class="Kleaner.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="360" Width="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuarantinePathLabel" Grid.Row="0" Margin="0,0,0,4" />
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BrowseButton" Click="OnBrowse" DockPanel.Dock="Right" Width="72" Margin="6,0,0,0" Padding="0,3" />
            <TextBox x:Name="QuarantinePathBox" Height="24" VerticalContentAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="RuleUpdateLabel" Grid.Row="2" Margin="0,0,0,4" />
        <TextBox x:Name="RuleUpdateUrlBox" Grid.Row="3" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,10" />
        <TextBlock x:Name="RuleUpdateShaLabel" Grid.Row="4" Margin="0,0,0,4" />
        <TextBox x:Name="RuleUpdateShaBox" Grid.Row="5" VerticalContentAlignment="Top" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="70" VerticalAlignment="Top" />
        <StackPanel Orientation="Horizontal" Grid.Row="6" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button x:Name="CheckUpdateButton" Click="OnCheckUpdate" Width="150" Padding="0,4" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Click="OnSave" Width="80" Padding="0,4" />
        </StackPanel>
    </Grid>
</Window>
