<Window x:Class="Kleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Height="680" Width="1040" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 自绘标题栏上的窗口控制按钮（深色 hover，非 MDIX 主题的一部分） -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F1707A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <!-- WindowChrome 最大化时内容溢出屏幕的补偿 -->
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 自绘标题栏 ===== -->
        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Foreground="White" />
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                    <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" Foreground="White" />
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                    <materialDesign:PackIcon Kind="SquareOutline" Width="13" Height="13" Foreground="White" />
                </Button>
                <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 工具栏（分组） ===== -->
        <Border Grid.Row="1" Padding="16,10" BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <!-- 操作组 -->
                <Button Command="{Binding ScanCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Padding="20,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanText}" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CleanCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Padding="20,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CleanText}" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelScanCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cancel" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CancelText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Margin="16,6" Fill="{DynamicResource MaterialDesignDivider}" />

                <!-- 查看组 -->
                <Button Command="{Binding OpenQuarantineCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding QuarantineText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenHistoryCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HistoryText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenToolboxCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Wrench" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ToolboxText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenStartupCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RocketLaunch" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StartupText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Margin="16,6" Fill="{DynamicResource MaterialDesignDivider}" />

                <!-- 设置组 -->
                <Button Command="{Binding OpenAdvancedCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AdvancedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SettingsText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Row="2" Margin="16,16,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid x:Name="RulesGrid" Grid.Row="0"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      ItemsSource="{Binding Rows}" SelectionMode="Single" SelectedItem="{Binding SelectedRow}"
                      GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="40" Margin="0,0,0,4">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="230" />
                    <DataGridTextColumn Binding="{Binding CategoryDisplay}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Binding="{Binding FileCount}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Binding="{Binding RiskDisplay}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Binding="{Binding ElevatedDisplay}" IsReadOnly="True" Width="60" />
                    <DataGridTextColumn Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 安全说明改为 Card -->
            <materialDesign:Card Grid.Row="1" Margin="0,12,0,0" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SafetyHeader}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Text="{Binding SafetyNotesText}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0"
                Background="{DynamicResource MaterialDesignPaper}">
            <TextBlock Text="{Binding StatusText}" Margin="16,8" />
        </Border>
    </Grid>
</Window>
