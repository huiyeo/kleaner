<Window x:Class="Kleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kleaner" Height="660" Width="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10,8">
            <Button x:Name="ScanButton" Click="OnScan" Width="96" Padding="0,4" />
            <Button x:Name="CleanButton" Click="OnClean" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="QuarantineButton" Click="OnQuarantine" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="ToolboxButton" Click="OnToolbox" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="HistoryButton" Click="OnHistory" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="StartupButton" Click="OnStartup" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="AdvancedButton" Click="OnAdvanced" Width="96" Padding="0,4" Margin="8,0,0,0" />
            <Button x:Name="SettingsButton" Click="OnSettings" Width="96" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="…" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="10,4,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="RulesGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" SelectionChanged="OnSelectionChanged" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True" Width="230" />
                    <DataGridTextColumn Binding="{Binding CategoryDisplay}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Binding="{Binding FileCount}" IsReadOnly="True" Width="70" />
                    <DataGridTextColumn Binding="{Binding SizeDisplay}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Binding="{Binding RiskDisplay}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Binding="{Binding ElevatedDisplay}" IsReadOnly="True" Width="60" />
                    <DataGridTextColumn Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GroupBox x:Name="SafetyBox" Grid.Row="1" Padding="6">
                <TextBox x:Name="SafetyNotesBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
